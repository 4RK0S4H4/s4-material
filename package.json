{
  "name": "s4-orion",
  "version": "1.0.0",
  "private": true,
  "description": "S4 Orion: a personal design language on Material 3 Expressive, with a glass layer for floating chrome.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "generate:color": "node scripts/generate-color.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "check:tokens": "node scripts/build-tokens.mjs --check",
    "build": "npm run build:tokens",
    "check": "npm run check:tokens"
  }
}

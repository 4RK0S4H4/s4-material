{
  "$description": "The glass layer (decision 0004): very clear frosted glass on floating chrome and overlays only, with a guaranteed contrast floor. The backdrop filter compresses whatever shows through (contrast and brightness) so on-surface text on the glass meets WCAG AA over any backdrop, for every seed (checked by scripts/check-glass.mjs). High contrast, reduced transparency and browsers without backdrop-filter make glass solid.",
  "s4": {
    "glass": {
      "tint": {
        "$type": "color",
        "$description": "The surface role glass is tinted with.",
        "float": {
          "$value": "{md.sys.color.surface-container}",
          "$description": "App bars over scrolled content, nav bar, nav rail, toolbars, menus, sheets, dialogs, rich tooltips."
        },
        "fill": {
          "$value": "{md.sys.color.surface-container-highest}",
          "$description": "Tonal fills inside a glass surface (no blur of their own)."
        }
      },
      "tint-opacity": {
        "$type": "number",
        "$description": "How much of the tint role is painted over the blurred backdrop (0\u20131).",
        "float": {
          "$value": 0.6,
          "$extensions": {
            "com.s4.modes": {
              "high-contrast": 1,
              "dark-high-contrast": 1,
              "reduced-transparency": 1
            }
          }
        },
        "fill": {
          "$value": 0.56,
          "$extensions": {
            "com.s4.modes": {
              "dark": 0.64,
              "high-contrast": 1,
              "dark-high-contrast": 1,
              "reduced-transparency": 1
            }
          }
        },
        "medium-contrast": {
          "$value": 0.8,
          "$description": "Float tint when the app runs at medium contrast (contrast level 0.5)."
        }
      },
      "blur": {
        "$type": "dimension",
        "float": {
          "$value": {
            "value": 16,
            "unit": "px"
          },
          "$extensions": {
            "com.s4.modes": {
              "high-contrast": {
                "value": 0,
                "unit": "px"
              },
              "reduced-transparency": {
                "value": 0,
                "unit": "px"
              }
            }
          },
          "$description": "Backdrop blur radius."
        }
      },
      "saturation": {
        "$type": "number",
        "float": {
          "$value": 1.8,
          "$description": "saturate() on the backdrop, so color showing through stays lively."
        }
      },
      "backdrop-contrast": {
        "$type": "number",
        "float": {
          "$value": 0.74,
          "$extensions": {
            "com.s4.modes": {
              "dark": 1
            }
          },
          "$description": "contrast() on the backdrop: lifts blacks behind light glass so dark text keeps 4.5:1."
        }
      },
      "backdrop-brightness": {
        "$type": "number",
        "float": {
          "$value": 1.1,
          "$extensions": {
            "com.s4.modes": {
              "dark": 0.8
            }
          },
          "$description": "brightness() on the backdrop: dims whites behind dark glass so light text keeps 4.5:1."
        }
      },
      "highlight": {
        "$description": "Hairline edge: a 1px light line along the top edge of a glass surface (decision 0004: Edge B).",
        "width": {
          "$type": "dimension",
          "$value": {
            "value": 1,
            "unit": "px"
          }
        },
        "color": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "alpha": 0.5,
            "hex": "#ffffff"
          },
          "$extensions": {
            "com.s4.modes": {
              "dark": {
                "colorSpace": "srgb",
                "components": [
                  1,
                  1,
                  1
                ],
                "alpha": 0.12,
                "hex": "#ffffff"
              },
              "high-contrast": {
                "colorSpace": "srgb",
                "components": [
                  1,
                  1,
                  1
                ],
                "alpha": 0,
                "hex": "#ffffff"
              },
              "dark-high-contrast": {
                "colorSpace": "srgb",
                "components": [
                  1,
                  1,
                  1
                ],
                "alpha": 0,
                "hex": "#ffffff"
              },
              "reduced-transparency": {
                "colorSpace": "srgb",
                "components": [
                  1,
                  1,
                  1
                ],
                "alpha": 0,
                "hex": "#ffffff"
              }
            }
          }
        }
      },
      "max-stack": {
        "$type": "number",
        "$value": 2,
        "$description": "At most two glass layers overlap at any point (e.g. a menu over an app bar). A third becomes solid."
      }
    }
  }
}

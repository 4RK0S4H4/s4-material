{
  "$description": "The glass layer: frosted surfaces for floating chrome only (decision 0001). Values carry over from S4 Material 1.3's float glass; Phase 4 refines them in the glass lab. Glass is tinted with a surface role, blurred and saturated; every accessibility mode turns it solid.",
  "s4": {
    "glass": {
      "tint": {
        "$type": "color",
        "$description": "The surface role each glass level is tinted with.",
        "float": {
          "$value": "{md.sys.color.surface-container}"
        },
        "fill": {
          "$value": "{md.sys.color.surface-container-highest}"
        }
      },
      "tint-opacity": {
        "$type": "number",
        "$description": "How much of the tint role is painted over the blur (0\u20131). Higher = more solid, more contrast.",
        "float": {
          "$value": 0.84,
          "$extensions": {
            "com.s4.modes": {
              "dark": 0.82,
              "high-contrast": 1,
              "dark-high-contrast": 1,
              "reduced-transparency": 1
            }
          },
          "$description": "App bars over scrolled content, nav bar, toolbars, menus, sheets, dialogs, rich tooltips."
        },
        "fill": {
          "$value": 0.56,
          "$extensions": {
            "com.s4.modes": {
              "dark": 0.64,
              "high-contrast": 1,
              "dark-high-contrast": 1,
              "reduced-transparency": 1
            }
          },
          "$description": "Tonal fills inside a glass surface (no blur of their own)."
        },
        "medium-contrast": {
          "$value": 0.9,
          "$description": "Float tint at contrast level 0.5 (set at run time)."
        }
      },
      "blur": {
        "$type": "dimension",
        "$description": "Backdrop blur radius.",
        "small": {
          "$value": {
            "value": 12,
            "unit": "px"
          },
          "$extensions": {
            "com.s4.modes": {
              "reduced-transparency": {
                "value": 0,
                "unit": "px"
              },
              "high-contrast": {
                "value": 0,
                "unit": "px"
              }
            }
          }
        },
        "medium": {
          "$value": {
            "value": 24,
            "unit": "px"
          },
          "$extensions": {
            "com.s4.modes": {
              "reduced-transparency": {
                "value": 0,
                "unit": "px"
              },
              "high-contrast": {
                "value": 0,
                "unit": "px"
              }
            }
          }
        },
        "large": {
          "$value": {
            "value": 32,
            "unit": "px"
          },
          "$extensions": {
            "com.s4.modes": {
              "reduced-transparency": {
                "value": 0,
                "unit": "px"
              },
              "high-contrast": {
                "value": 0,
                "unit": "px"
              }
            }
          },
          "$description": "Float glass."
        }
      },
      "saturation": {
        "$type": "number",
        "$description": "Backdrop saturate() multiplier, so color showing through stays lively instead of going grey.",
        "float": {
          "$value": 1.35
        }
      },
      "highlight": {
        "$description": "Border highlight: a thin light edge on the top of a glass surface. S4 Material used none; Phase 4 decides whether Orion does.",
        "width": {
          "$type": "dimension",
          "$value": {
            "value": 1,
            "unit": "px"
          }
        },
        "color": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "alpha": 0.5,
            "hex": "#ffffff"
          },
          "$extensions": {
            "com.s4.modes": {
              "dark": {
                "colorSpace": "srgb",
                "components": [
                  1,
                  1,
                  1
                ],
                "alpha": 0.12,
                "hex": "#ffffff"
              },
              "high-contrast": {
                "colorSpace": "srgb",
                "components": [
                  1,
                  1,
                  1
                ],
                "alpha": 0,
                "hex": "#ffffff"
              },
              "dark-high-contrast": {
                "colorSpace": "srgb",
                "components": [
                  1,
                  1,
                  1
                ],
                "alpha": 0,
                "hex": "#ffffff"
              },
              "reduced-transparency": {
                "colorSpace": "srgb",
                "components": [
                  1,
                  1,
                  1
                ],
                "alpha": 0,
                "hex": "#ffffff"
              }
            }
          }
        }
      },
      "max-stack": {
        "$type": "number",
        "$value": 2,
        "$description": "At most two glass layers may overlap at any point (e.g. a menu over an app bar). A third is solid."
      }
    }
  }
}
